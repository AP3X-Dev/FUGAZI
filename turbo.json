{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "package.json", "tsconfig.json", "../../tsconfig.base.json"],
      "outputs": ["dist/**", "!dist/.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "../../tsconfig.base.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/__tests__/**", "vitest.config.ts", "package.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**/*.ts", "../../biome.json"],
      "outputs": []
    },
    "conformance": {
      "dependsOn": ["build"],
      "inputs": ["dist/**", "../../fixtures/conformance/**"],
      "outputs": []
    }
  }
}
