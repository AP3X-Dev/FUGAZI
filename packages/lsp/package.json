{
  "name": "@fugazi/lsp",
  "version": "0.1.0-rc.1",
  "private": false,
  "description": "Fugazi Language Server Protocol implementation for TypeScript/JavaScript static analysis.",
  "keywords": ["typescript", "javascript", "lsp", "language-server", "static-analysis", "fugazi"],
  "license": "MIT",
  "author": "AP3X",
  "homepage": "https://github.com/AP3X/fugazi#readme",
  "bugs": {
    "url": "https://github.com/AP3X/fugazi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AP3X/fugazi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@fugazi/config": "workspace:*",
    "@fugazi/core": "workspace:*",
    "@fugazi/extract": "workspace:*",
    "@fugazi/graph": "workspace:*",
    "@fugazi/runtime": "workspace:*",
    "@fugazi/types": "workspace:*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
