{
  "name": "@fugazi/node",
  "version": "0.1.0-rc.1",
  "private": false,
  "description": "Fugazi programmatic Node API: analyze, dead-code, dupes, health, audit, traceFile, traceExport.",
  "keywords": [
    "typescript",
    "javascript",
    "static-analysis",
    "dead-code",
    "duplication",
    "fugazi",
    "api"
  ],
  "license": "MIT",
  "author": "AP3X",
  "homepage": "https://github.com/AP3X/fugazi#readme",
  "bugs": {
    "url": "https://github.com/AP3X/fugazi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AP3X/fugazi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@fugazi/types": "workspace:*",
    "@fugazi/config": "workspace:*",
    "@fugazi/extract": "workspace:*",
    "@fugazi/graph": "workspace:*",
    "@fugazi/core": "workspace:*",
    "@fugazi/v8-coverage": "workspace:*",
    "@fugazi/runtime": "workspace:*"
  }
}
