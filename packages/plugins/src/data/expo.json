{
  "$schema": "../../../../plugin-schema.json",
  "name": "expo",
  "enablers": [
    "expo"
  ],
  "entryPoints": [
    "App.{ts,tsx,js,jsx}",
    "app/**/*.{ts,tsx,js,jsx}",
    "src/App.{ts,tsx,js,jsx}"
  ],
  "entryPointRole": "runtime",
  "alwaysUsed": [
    "app.json",
    "app.config.{ts,js,mjs,cjs}",
    "metro.config.{ts,js,mjs,cjs}",
    "babel.config.{ts,js,mjs,cjs}"
  ],
  "toolingDependencies": [
    "expo",
    "expo-cli",
    "@expo/webpack-config"
  ]
}
