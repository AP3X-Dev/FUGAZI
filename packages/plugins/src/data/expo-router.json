{
  "$schema": "../../../../plugin-schema.json",
  "name": "expo-router",
  "enablers": [
    "expo-router"
  ],
  "entryPointRole": "runtime",
  "configPatterns": [
    "app.json",
    "app.config.{ts,js,mjs,cjs}"
  ],
  "alwaysUsed": [
    "app.json",
    "app.config.{ts,js,mjs,cjs}",
    "metro.config.{ts,js,mjs,cjs}",
    "babel.config.{ts,js,mjs,cjs}",
    "expo-env.d.ts"
  ],
  "toolingDependencies": [
    "expo",
    "expo-router",
    "expo-linking",
    "expo-server",
    "@expo/metro-runtime"
  ]
}
