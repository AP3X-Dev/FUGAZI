{
  "$schema": "../../../../plugin-schema.json",
  "name": "i18next",
  "enablers": [
    "i18next",
    "react-i18next",
    "vue-i18n",
    "next-i18next"
  ],
  "entryPoints": [
    "src/i18n.{ts,js,mjs}",
    "src/i18n/index.{ts,js}",
    "i18n.{ts,js,mjs}",
    "i18n/index.{ts,js}"
  ],
  "alwaysUsed": [
    "src/i18n.{ts,js,mjs}",
    "src/i18n/index.{ts,js}",
    "i18n.{ts,js,mjs}",
    "i18n/index.{ts,js}",
    "i18next.config.{js,ts,mjs}",
    "next-i18next.config.{js,mjs}",
    "locales/**/*.json",
    "public/locales/**/*.json",
    "src/locales/**/*.json"
  ],
  "toolingDependencies": [
    "i18next",
    "react-i18next",
    "vue-i18n",
    "next-i18next",
    "i18next-parser",
    "i18next-scanner"
  ]
}
