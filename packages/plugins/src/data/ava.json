{
  "$schema": "../../../../plugin-schema.json",
  "name": "ava",
  "enablers": [
    "ava"
  ],
  "entryPoints": [
    "test/**/*.{ts,tsx,js,jsx}",
    "tests/**/*.{ts,tsx,js,jsx}",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}"
  ],
  "entryPointRole": "test",
  "alwaysUsed": [
    "ava.config.{js,cjs,mjs}"
  ],
  "toolingDependencies": [
    "ava",
    "@ava/typescript"
  ]
}
