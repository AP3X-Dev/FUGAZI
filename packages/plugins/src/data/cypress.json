{
  "$schema": "../../../../plugin-schema.json",
  "name": "cypress",
  "enablers": [
    "cypress"
  ],
  "entryPoints": [
    "**/*.cy.{ts,tsx,js,jsx}",
    "cypress/**/*.{ts,tsx,js,jsx}",
    "cypress/support/**/*.{ts,js}"
  ],
  "entryPointRole": "test",
  "configPatterns": [
    "cypress.config.{ts,js,mjs,cjs}"
  ],
  "alwaysUsed": [
    "cypress.config.{ts,js,mjs,cjs}"
  ],
  "toolingDependencies": [
    "cypress",
    "@cypress/react",
    "@cypress/vue"
  ]
}
