{
  "$schema": "../../../../plugin-schema.json",
  "name": "graphql-codegen",
  "enablers": [
    "@graphql-codegen/cli"
  ],
  "configPatterns": [
    "codegen.{ts,js}",
    "graphql.config.{ts,js}"
