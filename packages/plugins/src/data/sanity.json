{
  "$schema": "../../../../plugin-schema.json",
  "name": "sanity",
  "enablers": [
    "sanity",
    "@sanity/"
  ],
  "entryPoints": [
    "schemas/**/*.{ts,tsx,js,jsx}",
    "sanity/**/*.{ts,tsx,js,jsx}"
  ],
  "entryPointRole": "runtime",
  "alwaysUsed": [
    "sanity.config.{ts,js}",
    "sanity.cli.{ts,js}"
  ],
  "toolingDependencies": [
    "sanity",
    "@sanity/client",
    "@sanity/vision",
    "@sanity/cli"
  ]
}
