{
  "name": "@fugazi/mcp",
  "version": "0.1.0-rc.1",
  "private": false,
  "description": "Fugazi Model Context Protocol server: exposes static analysis tools to AI agents over stdio.",
  "keywords": [
    "typescript",
    "javascript",
    "mcp",
    "model-context-protocol",
    "static-analysis",
    "fugazi",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "AP3X",
  "homepage": "https://github.com/AP3X/fugazi#readme",
  "bugs": {
    "url": "https://github.com/AP3X/fugazi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AP3X/fugazi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@fugazi/config": "workspace:*",
    "@fugazi/core": "workspace:*",
    "@fugazi/extract": "workspace:*",
    "@fugazi/graph": "workspace:*",
    "@fugazi/node": "workspace:*",
    "@fugazi/runtime": "workspace:*",
    "@fugazi/types": "workspace:*",
    "@fugazi/v8-coverage": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.2"
  }
}
