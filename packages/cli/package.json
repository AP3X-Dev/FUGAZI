{
  "name": "fugazi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "bin": {
    "fugazi": "../../bin/fugazi.js",
    "fugazi-lsp": "../../bin/fugazi-lsp.js",
    "fugazi-mcp": "../../bin/fugazi-mcp.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@fugazi/types": "workspace:*",
    "@fugazi/config": "workspace:*",
    "@fugazi/core": "workspace:*",
    "@fugazi/runtime": "workspace:*",
    "@fugazi/node-api": "workspace:*"
  }
}
